# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Notebooks (executed in CI; do not commit checkpoint dirs)
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Documentation build (regenerated by `mkdocs build`)
site/

# Notebook side-effects (the notebook writes a demo report)
notebooks/_*.html
reports/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Secrets — never commit credentials
.env
.env.*
*.pem
*.key
credentials.json
